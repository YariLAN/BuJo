# Базовый URL REST API. По умолчанию '/api/v1' — Vite проксирует его на бэкенд
# (http://localhost:5129, см. vite.config.ts). Меняйте только для прод-сборки.
# VITE_API_BASE_URL=/api/v1

# Telegram ID для локальной разработки вне Telegram.
# Должен соответствовать пользователю, уже созданному ботом (через /start).
VITE_DEV_TELEGRAM_ID=123456789
